{
  "name": "gfl2-roguelite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-prod-assets.mjs",
    "check:prod-assets": "node scripts/check-prod-assets.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:chaser-review": "node scripts/chaser-review.mjs",
    "test:tram-review": "node scripts/tram-circuit-check.mjs",
    "test:tram-circuit": "node scripts/tram-circuit-check.mjs",
    "test:tololo-locomotion": "node scripts/tololo-locomotion-check.mjs",
    "perf:chaser": "node scripts/chaser-perf.mjs",
    "perf:tololo": "node scripts/tololo-perf.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babylonjs/core": "9.25.0",
    "@babylonjs/loaders": "9.25.0",
    "babylon-mmd": "1.3.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
